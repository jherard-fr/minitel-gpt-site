# minitel-evenementiel.com est un domaine d'envoi géré par Instantly (prospection
# cold-email), configuré côté Instantly pour proxier/mirrorer ce site en transparent
# (même contenu, chemin par chemin) — c'est pourquoi une redirection posée ICI
# s'applique aussi sur ce domaine. Sert à donner un lien de désabonnement aligné avec
# le domaine expéditeur plutôt que le domaine de l'app de prospection (outreach.herard.com),
# sans toucher au DNS (qu'on ne contrôle pas sur ce domaine). La page réelle de
# désabonnement (mise à jour en base) reste sur l'app — ceci n'est qu'un renvoi.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^se-desinscrire/?$ https://outreach.herard.com/unsubscribe [R=302,L,QSA]
</IfModule>

# Bloque tout accès web au dossier de données (hits, géoloc, IP exclues, logs…)
<IfModule mod_alias.c>
  RedirectMatch 403 ^/data/
</IfModule>
<FilesMatch "(hits\.jsonl|geo\.json|exclude_ips\.json|contact-errors\.log|rl_.*\.txt)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Cache : HTML et CSS toujours revalidés (les mises à jour s'affichent tout de
# suite), images et vidéo mises en cache (stables / versionnées via ?v=).
<IfModule mod_headers.c>
  <FilesMatch "\.(html|css|js|php)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 0 seconds"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/jpeg "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType video/mp4 "access plus 30 days"
</IfModule>
